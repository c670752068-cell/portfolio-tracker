# 富途 OpenD 配置模板（服务器版）
# 用法：install-opend.sh 会把它复制成 /opt/futu-opend/OpenD.ini。把 <<< >>> 的地方换成你自己的内容。
# 这份模板里没有、也绝不会有：交易解锁密码、下单相关的任何配置。
# 本程序在服务器上只用于「读行情 + 读持仓」。

[server]
# 只监听本机回环地址，外网访问不到；网关和它在同一台机器上
ip=127.0.0.1
port=11111
# 不开放对外的 websocket
websocket_port=0

[account]
# 你的富途账号（手机号或 UID），回来后自己填
login_account=<<<在这里填你的富途账号>>>
# 登录密码的 MD5（OpenD 要求用 MD5，不是明文）
# 在你自己的电脑上算：printf '%s' '你的密码' | md5sum   （macOS 用 md5 -q -s '你的密码'）
# 也可以整行留空，改用交互式登录
login_pwd_md5=<<<在这里填密码的MD5，或留空改用交互式登录>>>

[lang]
# 简体中文
lang=chs

[log]
log_level=no_output
# 日志写到这里，方便排查登录和验证码问题
log_path=/opt/futu-opend/logs

[qot]
# 只订阅行情，不做任何交易动作
