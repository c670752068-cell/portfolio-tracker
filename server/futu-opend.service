# 富途 OpenD（服务器版）systemd 单元
# 装好之后先不要 enable --now：等账号填好、第一次交互式登录过了验证码再开机自启。
[Unit]
Description=Futu OpenD (quotes and positions only, loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/futu-opend
ExecStart=/opt/futu-opend/FutuOpenD -cfg_file=/opt/futu-opend/OpenD.ini
Restart=always
RestartSec=10
# 这台机器内存紧张，给它一个上限，超了就重启而不是把整机拖垮
MemoryMax=450M
# OpenD 在没有终端时会一直刷提示符，写进普通文件会把磁盘撑爆；
# 交给 journal，它自带限流和容量上限。看日志：journalctl -u futu-opend -f
StandardOutput=journal
StandardError=journal
# 只读行情，不需要额外权限
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
